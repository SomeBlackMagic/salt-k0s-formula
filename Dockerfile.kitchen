FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    dbus \
    systemd \
    systemd-sysv \
    sudo \
    openssh-server \
    curl \
    wget \
    lsb-release \
    ruby \
    ruby-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install salt via bootstrap
ADD https://github.com/saltstack/salt-bootstrap/releases/latest/download/bootstrap-salt.sh /tmp/bootstrap-salt.sh
# -X = do not start services after install (no systemd in Docker)
RUN chmod +x /tmp/bootstrap-salt.sh && sh /tmp/bootstrap-salt.sh -X stable; \
    salt-call --version && rm /tmp/bootstrap-salt.sh

STOPSIGNAL SIGRTMIN+3
