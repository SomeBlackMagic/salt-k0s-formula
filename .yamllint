# -*- coding: utf-8 -*-
# vim: ft=yaml
---
extends: 'default'

rules:
  comments:
    min-spaces-from-content: 1
  document-start: disable
  empty-values:
    forbid-in-block-mappings: true
    forbid-in-flow-mappings: true
  line-length:
    max: 120
    allow-non-breakable-inline-mappings: true
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    # Allow 'on' as a mapping key (used by GitHub Actions workflow triggers)
    check-keys: false

ignore: |
  .git/
  .kitchen/
  .venv/
  vendor/
  reports/
  k0s/files/
  .saltbundle.yaml
