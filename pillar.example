k0s:
  version: 'v1.30.2+k0s.0'
  role: single  # single | controller | worker
  config_path: /etc/k0s/k0s.yaml
  data_dir: /var/lib/k0s

  install:
    binary_url: ''   # optional: custom download URL
    checksum: ''     # optional: SHA256 checksum

  config:
    spec:
      api:
        address: ''
        sans:
          - k0s.local
      network:
        provider: kuberouter
        podCIDR: 10.244.0.0/16
        serviceCIDR: 10.96.0.0/12
      storage:
        type: etcd
      telemetry:
        enabled: false

  controller:
    enable_worker: false
    no_taints: false

  worker:
    join_token: ''
    api_address: ''
    profile: default

  token:
    ttl: 24
    path: /etc/k0s/worker-join-token

  service:
    enabled: true
    running: true

  # Kubernetes manifests to apply after the cluster is up.
  # Each entry requires at least one of: source, content.
  # Both may be specified simultaneously — they are concatenated before applying.
  #
  # Optional wait conditions (kubectl wait) may be added per manifest.
  # Each condition requires: for, resource. Optional: timeout, namespace.
  manifests:
    # Apply a manifest from a file on the local filesystem.
    - name: nginx-deployment
      source: /srv/salt/k0s/files/manifests/nginx.yaml

    # Apply an inline YAML manifest.
    - name: coredns-configmap
      content: |
        apiVersion: v1
        kind: ConfigMap
        metadata:
          name: coredns-custom
          namespace: kube-system
        data:
          log.override: |
            log

    # Apply both a file and inline content together.
    - name: app-namespace-and-quota
      source: /srv/salt/k0s/files/manifests/namespace.yaml
      content: |
        apiVersion: v1
        kind: ResourceQuota
        metadata:
          name: default-quota
          namespace: my-app
        spec:
          hard:
            pods: "10"

    # Apply CRDs and wait for them to be established before proceeding.
    - name: my-crds
      source: /srv/salt/k0s/files/manifests/crds.yaml
      wait:
        - for: condition=Established
          resource: crd/myresources.example.com
          timeout: 60s

    # Apply a deployment and wait for it to become available in a specific namespace.
    - name: my-app
      content: |
        apiVersion: apps/v1
        kind: Deployment
        metadata:
          name: my-app
          namespace: prod
        spec:
          replicas: 1
          selector:
            matchLabels:
              app: my-app
          template:
            metadata:
              labels:
                app: my-app
            spec:
              containers:
                - name: my-app
                  image: my-app:latest
      wait:
        - for: condition=Available
          resource: deployment/my-app
          namespace: prod
          timeout: 120s